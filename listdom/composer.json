{
    "name": "webilia/listdom",
    "version": "dev-main",
    "authors": [
        {
            "name": "Webilia",
            "email": "hello@webilia.com"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/webilia/webilia-ui"
        },
        {
            "type": "path",
            "url": "../../packages/*/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "config": {
        "platform-check": false,
        "platform": {
            "php": "7.4.33"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9",
        "yoast/phpunit-polyfills": "^1.0"
    },
    "require": {
        "webilia/ui": "^1.4.1",
        "webilia/connect": "^1.1.5",
        "webilia/wp": "^1.0.23",
        "webilia/listdom-p-visibility": "@dev",
        "stripe/stripe-php": "^17.6"
    }
}
